# ============================================================================
# Ekiden — backend/.env.example
# Copy this file to .env and fill in real values. .env is gitignored and
# never committed; this file holds no secrets, only placeholders, so anyone
# cloning the repo can see exactly what's configurable. The app degrades
# gracefully and keeps working without every value filled in, just with
# weaker output on the pieces that need a given provider.
# ============================================================================

# --- Qwen Cloud (dashscope-intl, OpenAI-compatible mode) ------------------
# Powers: preference extraction, area resolution, search ranking, fee
# extraction, translation/romanization, follow-up Q&A.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-flash

# --- ai& (two model tiers on one account) ----------------------------------
# AIAND_MODEL_FAST: trust-check fallback tier (after GMI, before rule-based).
# AIAND_MODEL_QUALITY: eligibility analysis, inquiry email, strategy advisor
# fallback tier (after GMI).
AIAND_BASE_URL=
AIAND_API_KEY=
AIAND_MODEL_FAST=
AIAND_MODEL_QUALITY=

# --- GMI Cloud --------------------------------------------------------------
# Powers: bait-listing trust check (primary) and strategy advisor (primary) —
# deliberately a different vendor from Qwen/ai& so these are a genuine
# independent second opinion, not the same model doing everything.
# Blank is fine — both features fall back to ai&'s quality/fast tier, then to
# Vertex AI Gemini, then to a deterministic rule-based/template result.
# Nothing breaks without this.
GMI_BASE_URL=
GMI_API_KEY=
GMI_MODEL=

# --- Vertex AI Gemini (universal fallback) ----------------------------------
# Tried automatically by providers/client.py whenever the requested primary
# provider above is unconfigured or fails twice — applies to EVERY agent
# call, not just specific ones. No API key needed: auth is via Application
# Default Credentials.
#   - On Cloud Run: the service's attached service account needs the
#     `roles/aiplatform.user` IAM role; no extra setup beyond that + these
#     env vars (cloudbuild.yaml sets GOOGLE_CLOUD_PROJECT to $PROJECT_ID
#     automatically).
#   - Locally: run `gcloud auth application-default login` once, then fill
#     in GOOGLE_CLOUD_PROJECT below to enable this fallback in local dev too.
#     Leave GOOGLE_CLOUD_PROJECT blank to skip Gemini entirely locally — the
#     existing fallback chains (aiand_fast / rule-based / templates) still
#     work exactly as before with zero risk.
# GOOGLE_GENAI_USE_VERTEXAI must be exactly "true" — this is the actual
# switch; without it, Gemini is treated as not configured even if the other
# three vars below are filled in.
# GOOGLE_CLOUD_LOCATION must be "global", not a region — gemini-3.x models
# are global-only (this is unrelated to which region the Cloud Run
# containers themselves run in).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# --- Daytona ------------------------------------------------------------
# Sandboxes the true-cost arithmetic (services/daytona.py). Falls back to
# identical local Python computation if unreachable — numbers never change,
# only whether they were sandboxed.
DAYTONA_API_KEY=
DAYTONA_BASE_URL=https://app.daytona.io/api

# --- App config ---------------------------------------------------------
# Comma-separated list of origins allowed to call this API (CORS). Add the
# deployed frontend's URL here once you have it, alongside localhost for
# local dev, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://your-deployed-url.run.app
ALLOWED_ORIGINS=http://localhost:3000

# Timeout (seconds) for each live HOME'S/SUUMO fetch, one retry each on
# failure. Raise this if live searches are timing out on a slower network.
LIVE_SEARCH_TIMEOUT_S=8.0
